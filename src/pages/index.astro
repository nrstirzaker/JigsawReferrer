---
import '../styles/global.css'

import { auth } from '@/lib/auth'
const session = await auth.api.getSession({
    headers: Astro.request.headers,
})
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Dev Menu</title>
        <style>
            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
            }
            /* Add a black background color to the top navigation */
            .topnav {
                background-color: #333;
                overflow: hidden;
            }

            /* Style the links inside the navigation bar */
            .topnav a {
                float: left;
                color: #f2f2f2;
                text-align: center;
                padding: 14px 16px;
                text-decoration: none;
                font-size: 17px;
            }

            /* Change the color of links on hover */
            .topnav a:hover {
                background-color: #ddd;
                color: black;
            }

            /* Add a color to the active/current link */
            .topnav a.active {
                background-color: #04aa6d;
                color: white;
            }
        </style>
    </head>

    <body>
        <div class="topnav">
            <a href="signup">Sign Up</a>
            <a href="signin">Sign In</a>
            <a href="forgottenpassword">Forgotten Password</a>
            <a href="resetpassword">Reset Password (with Token)</a>
            <a href="changepassword">Change Password</a>
            <a href="verifyemail">Verify Email Template</a>
            <a href="forgottenpasswordemail">Forgotten Password Template</a>
            <a href="securepage">Secure Page</a>
            <a href="openpage">Open Page</a>
            <a href="signout">Sign Out</a>
        </div>
    </body>
</html>
